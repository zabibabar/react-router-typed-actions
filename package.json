{
  "name": "react-router-typed-actions",
  "version": "0.1.0",
  "description": "Type-safe, serializable actions for React Router.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --ignore-pattern \"src/__tests__/**\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --ignore-pattern \"src/__tests__/**\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "react-router",
    "actions",
    "type-safe",
    "typed-actions",
    "form-data"
  ],
  "author": "Zabi Babar (https://github.com/zabibabar)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zabibabar/react-router-typed-actions.git"
  },
  "homepage": "https://github.com/zabibabar/react-router-typed-actions#readme",
  "bugs": "https://github.com/zabibabar/react-router-typed-actions/issues",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-router": ">=7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.5",
    "react-router": "^7.6.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "superjson": "^2.2.6"
  }
}
